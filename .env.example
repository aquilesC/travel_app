# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=trips.aquiles.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://trips.aquiles.me
DJANGO_TIME_ZONE=Europe/Amsterdam

# Postgres (use letters/digits only for the password; it ends up in a URL)
POSTGRES_DB=trips
POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me

# Host port the web container is published on (bound to 127.0.0.1 only)
WEB_PORT=8000
