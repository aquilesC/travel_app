# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=trips.aquiles.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://trips.aquiles.me
DJANGO_TIME_ZONE=Europe/Amsterdam
SITE_URL=https://trips.aquiles.me

# Postgres (use letters/digits only for the password; it ends up in a URL)
POSTGRES_DB=trips
POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me

# Host port nginx is published on (bound to 127.0.0.1 only; the tunnel points here)
WEB_PORT=8000

# Media on the external drive (see README). Leave commented until the drive is mounted.
# COMPOSE_FILE=compose.yaml:compose.hd.yaml
# MEDIA_HOST_PATH=/mnt/trips-media

# Email via Mailgun SMTP (Mailgun > Sending > Domain settings > SMTP credentials)
EMAIL_HOST=smtp.eu.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Trips <trips@your-mailgun-domain>

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886; later your own approved sender
TWILIO_WHATSAPP_FROM=
# Must match the URL configured in Twilio exactly (signatures depend on it)
TWILIO_WEBHOOK_URL=https://trips.aquiles.me/hooks/twilio/whatsapp/
